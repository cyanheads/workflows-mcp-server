# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)
# MCP_ALLOWED_ORIGINS=             # Comma-separated origins allowed by CORS (e.g. http://localhost:8080)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)
# MCP_REQUEST_STATE_KEY=            # Opt-in, >= 32 bytes, same on every instance: seals the requestState
                                    # handlers return; any other state is rejected before the handler runs.
                                    # workflow_delete's requestState carries its confirmation id, so set it
                                    # for HTTP deployments (e.g. `openssl rand -base64 32`)
# OAUTH_ISSUER_URL=                 # OAuth issuer (required for oauth mode)
# OAUTH_AUDIENCE=                   # OAuth audience (required for oauth mode)
# DEV_MCP_AUTH_BYPASS=false         # Development only: skip JWT verification
#
# jwt/oauth read granted scopes from the union of the `scp`, `scope`, and
# `mcp_tool_scopes` claims; `mcp_tool_scopes` is the path for OIDC providers that
# cannot override `scope` in authorization_code flow (Authentik, Keycloak <26.5,
# Zitadel). Where no claim-injection path exists, the flag below bypasses per-tool
# and runtime scope enforcement after the auth-context presence check; token
# signature, audience, issuer, and expiry validation remain intact. Combine it with
# server-side ACLs — without one, every authenticated user has every scope.
# MCP_AUTH_DISABLE_SCOPE_CHECKS=false

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1
# STORAGE_FILESYSTEM_PATH=./.storage  # Root directory for the filesystem provider
# SUPABASE_URL=                     # Required for the supabase provider
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateful           # auto | stateful | stateless (framework default: auto, which resolves to stateful).
                                    # This server requires stateful over HTTP: workflow_delete asks the user to
                                    # confirm before deleting, and a 2025-era HTTP client can only answer that
                                    # prompt over a live session. src/index.ts declares sessionMode
                                    # require: 'stateful', so an HTTP start with stateless fails at startup.
                                    # Stdio ignores this setting.
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load. Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# NODE_ENV=development              # development | production | testing
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# LOGS_DIR=logs/                    # Directory for log files
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_TOOL_FAILURE_PAYLOADS=false            # Log failed tool calls' arguments + result (key-name redaction only;
                                             # secrets in free-form values are kept). Reaches stderr, files, and OTLP
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Per-payload cap, UTF-8 bytes
# LOG_LLM_INTERACTIONS=false                 # Write full OpenRouter request/response bodies to interactions.log
                                             # instead of metadata (transcripts can carry PII and secrets)

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP base URL (e.g., http://localhost:4318); traces → /v1/traces, metrics → /v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base for metrics; used as-is
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Opt-in log export (e.g., http://localhost:4318/v1/logs); the base never enables it

# ── Server-specific ──────────────────────────────────────────────────
# Workflow library

# Absolute or relative path to the workflows root directory.
# Permanent workflows live under <WORKFLOWS_DIR>/categories/, temporary under <WORKFLOWS_DIR>/temp/.
WORKFLOWS_DIR=./workflows-yaml

# Path to the global instructions markdown file. Injected into every workflow_get response.
# Defaults to <WORKFLOWS_DIR>/global_instructions.md when not set.
# GLOBAL_INSTRUCTIONS_PATH=

# Milliseconds to debounce filesystem change events before rebuilding the index.
# Lower values make the index respond faster to writes; higher values reduce
# rebuild churn when many files change at once.
# WATCHER_DEBOUNCE_MS=500
